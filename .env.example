# 이 파일을 .env 로 복사한 뒤 실제 값을 채워서 사용한다.
# cp .env.example .env

# Grafana 관리자 비밀번호 (최초 로그인 후 반드시 변경 권장)
GF_SECURITY_ADMIN_PASSWORD=

# Grafana 익명 접근 허용 여부 (운영은 false 권장)
GF_AUTH_ANONYMOUS_ENABLED=false

# Alertmanager 알림 발신 Gmail 주소
GMAIL_SENDER=

# Gmail 앱 비밀번호 (2단계 인증 → 앱 비밀번호 16자리, 공백 포함)
GMAIL_APP_PASSWORD=

# 알림 수신 이메일 주소
GMAIL_RECEIVER=
